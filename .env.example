# Environment variables for BTC Quant Research Platform

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql+asyncpg://btcbot:btcbot@localhost:5432/btcbot

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Binance API Configuration
BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443/ws

# Data Storage Paths
RAW_DATA_PATH=./data/raw
PARQUET_DATA_PATH=./data/parquet

# CORS Origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# API Security (to be set before production deployment)
# API_KEY=your_api_key_here
# API_SECRET=your_api_secret_here

# Trading Configuration (Phase 1 only for trading terminal display)
TRADING_ENABLED=false
MAX_POSITION_SIZE=1000
RISK_PER_TRADE=0.01

# Monitoring and Logging
METRICS_PORT=8000
PROMETHEUS_ENABLED=false

# Development
DEBUG=true
HOT_RELOAD=true

# Data Provider Configuration
DEFAULT_SYMBOL=BTCUSDT
SUPPORTED_TIMEFRAMES=5m,15m,1h,4h,1d
MAX_INGESTION_DAYS=31

# Security (Phase 1 - public market data only)
# Exchange API credentials are not used in Phase 1
# All Phase 1 operations use public endpoints only
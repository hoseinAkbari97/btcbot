            "url": "{{frontendBaseUrl}}/",
            "description": "Loads the only declared React route, GET /."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns HTML', function () { pm.expect(pm.response.headers.get('Content-Type') || '').to.include('text/html'); });",
                  "pm.test('Contains the application root or title', function () { pm.expect(pm.response.text()).to.match(/BTC Quant Research Terminal|id=[\"']root[\"']/); });"

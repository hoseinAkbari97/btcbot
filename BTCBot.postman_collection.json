    {
      "name": "Backend - Health and Status",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{backendBaseUrl}}/health",
            "description": "FastAPI process liveness check. It does not test PostgreSQL or Redis."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Health payload is ok', function () { pm.expect(pm.response.json()).to.deep.equal({ status: 'ok' }); });"
                ]
              }
            }
          ]
        },
        {
          "name": "System status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{backendBaseUrl}}/api/v1/system/status",
            "description": "Reports API, PostgreSQL, and Redis status. A dependency failure is returned as a 200 response with status=degraded."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Payload has all component statuses', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.be.oneOf(['healthy', 'degraded']);",
                  "  pm.expect(body).to.have.all.keys('status', 'api', 'database', 'redis');",
                  "  pm.expect(body.api.status).to.be.oneOf(['up', 'down']);",
                  "  pm.expect(body.database.status).to.be.oneOf(['up', 'down']);",
                  "  pm.expect(body.redis.status).to.be.oneOf(['up', 'down']);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Backend - Candles",
      "item": [
        {
          "name": "Get candles with defaults",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{backendBaseUrl}}/api/v1/candles",
            "description": "Uses backend defaults: BTCUSDT, 5m, and limit 1000."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Candle page shape is valid', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.symbol).to.eql('BTCUSDT');",
                  "  pm.expect(body.timeframe).to.eql('5m');",
                  "  pm.expect(body.count).to.eql(body.candles.length);",
                  "  pm.expect(body.candles).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get filtered candles",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{backendBaseUrl}}/api/v1/candles?symbol={{symbol}}&timeframe={{timeframe}}&start={{rangeStart}}&end={{rangeEnd}}&limit=100",
            "description": "Reads a bounded candle range. Change collection variables to test another symbol, timeframe, or period."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response matches requested market', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.symbol).to.eql(pm.variables.get('symbol').replace('/', '').toUpperCase());",
                  "  pm.expect(body.timeframe).to.eql(pm.variables.get('timeframe'));",
                  "  pm.expect(body.count).to.eql(body.candles.length);",
                  "});",
                  "pm.test('Candles are chronological', function () {",
                  "  const candles = pm.response.json().candles;",
                  "  for (let index = 1; index < candles.length; index += 1) {",
                  "    pm.expect(new Date(candles[index].open_time).getTime()).to.be.at.least(new Date(candles[index - 1].open_time).getTime());",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject invalid candle range",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{backendBaseUrl}}/api/v1/candles?start=2026-09-23T00:00:00Z&end=2026-09-22T00:00:00Z",
            "description": "Negative test: start is after end and must be rejected."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 422', function () { pm.response.to.have.status(422); });",
                  "pm.test('Explains the date error', function () { pm.expect(pm.response.json().detail).to.eql('start must be before end'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Backend - Historical Ingestion",
      "description": "Warning: this request calls the configured provider and writes raw files, Parquet files, candles, and a quality report. Kraken is the default. The request covers one hour of 5m candles.",
      "item": [
        {
          "name": "Ingest historical candles",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbol\": \"{{symbol}}\",\n  \"timeframes\": [\"{{timeframe}}\"],\n  \"start\": \"{{ingestStart}}\",\n  \"end\": \"{{ingestEnd}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{backendBaseUrl}}/api/v1/market-data/ingest",
            "description": "Synchronous historical ingestion. The range must be timezone-aware, start before end, and no longer than 31 days."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns one ingestion result', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.be.an('array').with.lengthOf(1);",
                  "  pm.expect(body[0]).to.include.all.keys('symbol', 'timeframe', 'fetched', 'stored', 'duplicates', 'missing', 'invalid', 'anomalies', 'passed', 'quality_report_id', 'raw_file', 'parquet_files');",
                  "  pm.expect(body[0].symbol).to.eql(pm.variables.get('symbol').replace('/', '').toUpperCase());",
                  "  pm.expect(body[0].timeframe).to.eql(pm.variables.get('timeframe'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject ingestion over 31 days",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbol\": \"BTCUSDT\",\n  \"timeframes\": [\"5m\"],\n  \"start\": \"2026-07-01T00:00:00Z\",\n  \"end\": \"2026-09-01T00:00:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{backendBaseUrl}}/api/v1/market-data/ingest",
            "description": "Negative test: verifies the HTTP ingestion range limit before any provider request or storage write."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 422', function () { pm.response.to.have.status(422); });",
                  "pm.test('Explains the 31-day limit', function () { pm.expect(pm.response.json().detail).to.include('limited to 31 days'); });"
                ]
              }
            }
          ]
        }
      ]
    },

                  "const since = Math.floor(Date.now() / 1000) - (60 * 60);",
                  "pm.variables.set('krakenSince', String(since));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns Kraken OHLC data', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error).to.deep.equal([]);",
                  "  pm.expect(body.result).to.have.property('BTC/USDT');",

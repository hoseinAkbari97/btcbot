.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
node_modules/
frontend/dist/
# Emitted by `tsc -b` alongside the sources; regenerate with `npm run build`.
# These were committed by accident -- vite.config.js and vite.config.d.ts are
# compiled copies of vite.config.ts, and the .tsbuildinfo files are pure cache.
frontend/*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts
# NTFS alternate-data stream created when the spec was saved from a Windows
# browser download; carries no content.
*:Zone.Identifier
data/raw/*
data/processed/*
data/parquet/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/parquet/.gitkeep
*.log
.DS_Store
/*.venv*/


# --- Research datasets and derived artifacts (Phase 1-5 hardening) ---
# Canonical OHLCV datasets are hundreds of MB of JSON and are reproduced by
# `python -m app.cli data ingest`, not carried in version control. The manifest
# is kept: it is ~1 KB and records the sha256 of every file, so a clone can
# verify a freshly ingested dataset matches the one the research was run on.
backend/data/datasets/*.json
!backend/data/datasets/manifest.json

# Research output. The JSON report is a machine dump of every bootstrap run;
# the Markdown report is the human-readable summary and stays small enough to
# diff usefully.
data/research/*.json

# Segmented research run directories. These are *not* covered by the rule above
# because their contents live one level down and include the raw event spill:
# `events.jsonl` is ~320 MB for a single 2021 5m year, and `checkpoint.json` is
# ~11 MB of accumulator state. Both are rebuilt by re-running
# `scripts/run_segmented_research.py`, which resumes from the checkpoint rather
# than restarting, so committing them buys nothing and costs a clone 330 MB.
# Without this, `git add -A` sweeps the whole run into the next commit.
backend/data/research/run-*/
!backend/data/research/.gitkeep

# Checkpoints are per-run scratch state. Resuming is opt-in via --resume; a
# stale checkpoint from someone else's machine would silently resume into the
# wrong aggregate state, so they are never shared.
backend/data/checkpoints/
data/research/checkpoints/
*.checkpoint.json

# Monte Carlo handoff exports are regenerated from the ledger.
backend/data/exports/
data/exports/
backend/data/research/liquidity-q1-2021
backend/data/research/q1_feasibility/

# --- Stage 5A local audit inputs ---
# The full Setup 1 analysis ledger is a local, regenerated research artifact
# (~2.4 GB); the audit reads it but it is never committed.
analysis_setup1_dev/
# Scratch directory used to verify generated files; not part of the source tree.
.tmp-verify/

# --- Stage 6 generated accounting artifacts ---
# The canonical trade ledger is ~7 MB compressed and is regenerated from the
# local Setup 1 observation ledger. The daily equity curve is likewise rebuilt
# by `python stage6_rebuild/rebuild_setup1_accounting.py`. Keep the scripts, the
# Markdown report, and the small machine-readable summary in version control.
stage6_rebuild/canonical_trades.jsonl.gz
stage6_rebuild/daily_equity.csv
stage6_rebuild/__pycache__/

# --- Stage 6 v1 v2 generated accounting artifacts ---
# Same policy as the Stage 6 draft above: the canonical ledger, the equity
# curve, and the trade-level CSVs are rebuilt from the local Setup 1
# observation ledger by `python stage6_rebuild_v2/rebuild_setup1_accounting.py`.
# Keep the scripts, reports, summary, verification, and determinism metadata.
stage6_rebuild_v2/canonical_trades.jsonl.gz
stage6_rebuild_v2/daily_equity.csv
stage6_rebuild_v2/primary_portfolio_trades.csv
stage6_rebuild_v2/time_stop_trades.csv
stage6_rebuild_v2/__pycache__/

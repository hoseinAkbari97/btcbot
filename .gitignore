.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
node_modules/
frontend/dist/
data/raw/*
data/processed/*
data/parquet/*
!data/raw/.gitkeep
